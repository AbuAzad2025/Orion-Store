# Orion production environment — copy to .env.production and fill real values.
# NEVER commit the filled file (.env* is gitignored).

# Database (compose creates orion_admin + orion_app roles via initdb)
POSTGRES_PASSWORD=CHANGE_ME_ADMIN_DB_PASSWORD
POSTGRES_APP_PASSWORD=CHANGE_ME_APP_DB_PASSWORD

# Application secrets (>=16 chars; placeholders are rejected at boot)
SECRET_KEY=CHANGE_ME_RANDOM_64_CHARS
JWT_SECRET_KEY=CHANGE_ME_DIFFERENT_RANDOM_64_CHARS
ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY_GENERATED_BY_PYTHON

# Observability (optional but recommended)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# SMTP (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Live FX rates (exchangerate-api; cached locally with 1h TTL)
CURRENCY_LIVE_RATES=true
CURRENCY_RATE_TTL_SECONDS=3600
CURRENCY_RATE_PROVIDER_URL=https://open.er-api.com/v6/latest/{base}
CURRENCY_FX_MARKUP_PERCENT=3

# Feature gates
BETA_MODE=false
BETA_TENANT_SLUGS=
