{
  "name": "orion-store-assets",
  "version": "1.0.0",
  "private": true,
  "description": "Local Tailwind CSS build for Orion storefront and admin (no CDN at runtime).",
  "scripts": {
    "build:css": "tailwindcss -i ./01-FOUNDATION/assets/tailwind.input.css -o ./06-STOREFRONT/themes/default/static/css/tailwind.css --minify && tailwindcss -i ./01-FOUNDATION/assets/tailwind.input.css -o ./07-ADMIN/static/css/tailwind.css --minify && node scripts/copy-theme.js"
  },
  "devDependencies": {
    "tailwindcss": "3.4.19"
  }
}
